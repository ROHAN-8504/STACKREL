# Placeholder names only — never real values (SPEC.md Security: secrets and config).

# Public: safe to ship in the client bundle.
NEXT_PUBLIC_SITE_URL=https://stackrel.com
# Turnstile *site* key (public by design). Added in Phase 5.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Dev-only: set to 1 to include /styleguide in the build output.
NEXT_PUBLIC_ENABLE_STYLEGUIDE=

# Server-only. Set via `wrangler secret put`, never in this file and never
# with a NEXT_PUBLIC_ prefix. Added in Phase 5.
# TURNSTILE_SECRET=
# GITHUB_READ_TOKEN=
